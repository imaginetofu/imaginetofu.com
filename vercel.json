{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(work|dream|brand|og)/(.*)\\.(webm|mp4|webp|png|jpg|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.svg|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/my-work",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/my-work/",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/website-maintenance",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/website-maintenance/",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/project/:slug*",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/project-type/:slug*",
      "destination": "/#work",
      "permanent": true
    }
  ]
}
